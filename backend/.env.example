# Copy to .env (gitignored, never commit real secrets) and fill in.
# In Compose, api wiring (DATABASE_URL/REDIS_URL hostnames) is overridden by
# docker-compose.yml service DNS (db/redis); secrets below still apply.

# PostgreSQL via SQLAlchemy async driver (Compose DNS: db)
DATABASE_URL=postgresql+asyncpg://clinica:changeme-generate-a-password@db:5432/clinica
# Redis queues/jobs only, never source of truth (Compose DNS: redis)
REDIS_URL=redis://redis:6379/0
# Backoffice JWT signing — REQUIRED, no default. Generate: openssl rand -hex 32
JWT_SECRET=changeme-generate-256bit-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# WhatsApp Business API (official Meta; trial layer in v1, R-12)
WHATSAPP_API_TOKEN=changeme-meta-trial-token
WHATSAPP_PHONE_ID=changeme-meta-phone-id
# Firma HMAC del webhook (obligatoria) y capa de prueba v1
WHATSAPP_APP_SECRET=changeme-webhook-secret
WHATSAPP_PROVIDER=test
WHATSAPP_MAX_INTENTOS=5
WHATSAPP_WORKER_INTERVAL_SECONDS=60
# Mercado Pago (sandbox in v1, R-12)
MP_ACCESS_TOKEN=TEST-changeme-sandbox-token
# Provider de pagos: solo `test` está soportado en v1 (sin llamadas de red).
MP_PROVIDER=test
# Secreto HMAC del webhook (`x-signature`); obligatorio, sin default.
MP_WEBHOOK_SECRET=changeme-webhook-secret
# ARCA web services (homologacion in v1, R-12)
ARCA_CUIT=20000000001
ARCA_CERT=changeme-path-or-placeholder-cert
ARCA_KEY=changeme-path-or-placeholder-key
# Facturación ARCA: solo el proveedor simulado en v1 (sin red ni certificados).
# `responsable_inscripto` emite Factura B; `monotributista` emite Factura C.
ARCA_PROVIDER=test
ARCA_PUNTO_VENTA=1
ARCA_CONDICION_EMISOR=responsable_inscripto
ARCA_MAX_INTENTOS=5
ARCA_WORKER_INTERVAL_SECONDS=30
# Public base URL for links and webhooks
APP_BASE_URL=http://127.0.0.1:8080
# TTL del enlace público de gestión del turno (minutos; 10080 = 7 días)
GESTION_TOKEN_TTL_MINUTES=10080
# TTL de la oferta de lista de espera (minutos; 30 por defecto). Mientras la
# oferta está vigente el horario queda retenido y no se puede reservar.
LISTA_ESPERA_OFERTA_TTL_MINUTOS=30
# Demo seed admin password — required only when running `python -m app.seed`
# (no hardcoded default: the seed aborts naming this variable if missing).
SEED_ADMIN_PASSWORD=changeme-generate-a-demo-admin-password
# Browser origins allowed to call the API (SPA and API live on different ports).
# Comma-separated; no wildcard (credentials are header-based, see R-03).
CORS_ALLOW_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
