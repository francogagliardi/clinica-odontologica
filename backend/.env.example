# Copy to .env (gitignored, never commit real secrets) and fill in.
# In Compose, api wiring (DATABASE_URL/REDIS_URL hostnames) is overridden by
# docker-compose.yml service DNS (db/redis); secrets below still apply.

# PostgreSQL via SQLAlchemy async driver (Compose DNS: db)
DATABASE_URL=postgresql+asyncpg://clinica:changeme-generate-a-password@db:5432/clinica
# Redis queues/jobs only, never source of truth (Compose DNS: redis)
REDIS_URL=redis://redis:6379/0
# Backoffice JWT signing — REQUIRED, no default. Generate: openssl rand -hex 32
JWT_SECRET=changeme-generate-256bit-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# WhatsApp Business API (official Meta; trial layer in v1, R-12)
WHATSAPP_API_TOKEN=changeme-meta-trial-token
WHATSAPP_PHONE_ID=changeme-meta-phone-id
# Mercado Pago (sandbox in v1, R-12)
MP_ACCESS_TOKEN=TEST-changeme-sandbox-token
# ARCA web services (homologacion in v1, R-12)
ARCA_CUIT=20000000001
ARCA_CERT=changeme-path-or-placeholder-cert
ARCA_KEY=changeme-path-or-placeholder-key
# Public base URL for links and webhooks
APP_BASE_URL=http://127.0.0.1:8080
